# Copy to .env. Space-separated owner/repo list used when no repo is passed.
REPOS="your-user/your-repo"

# Custom label; workflows target ["self-hosted", LABEL].
LABEL=laptop

# Each runner has its own dockerd and network namespace, so concurrent jobs can publish
# the same ports. Each one costs a dockerd plus whatever its job uses (CPU/RAM of the VM).
RUNNERS_PER_REPO=3

# Repo variable the workflow reads in runs-on.
RUNS_ON_VAR=CI_RUNS_ON

# true: `down` unsets RUNS_ON_VAR so jobs run on GitHub-hosted while the laptop is off.
# false: jobs queue (up to 24h) until the next `up`.
FALLBACK_TO_HOSTED=true
